# =============================================================================
# Enterprise RAG Knowledge Assistant — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Recommended: Free LLM & Embeddings (Google Gemini) ---
# Get your free key at: https://aistudio.google.com/app/apikey (No credit card needed)
GOOGLE_API_KEY=replace-with-your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Optional: Anthropic Claude ---
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
LLM_MODEL=claude-sonnet-4-20250514

# --- Optional: OpenAI ---
OPENAI_API_KEY=replace-with-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small


# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=./storage/chroma

# --- Retrieval Settings ---
TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Upload Limits ---
MAX_UPLOAD_MB=10

# --- Application ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info
